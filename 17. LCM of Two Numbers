using System;

class Program
{
    static void Main()
    {
        int a = 12, b = 18, lcm;

        int max = (a > b) ? a : b;

        while (true)
        {
            if (max % a == 0 && max % b == 0)
            {
                lcm = max;
                break;
            }
            max++;
        }

        Console.WriteLine(lcm);
    }
}
