using System;

class Fibonacci
{
    static void Main()
    {
        int a = 0, b = 1, c;
        Console.Write("Enter limit: ");
        int n = int.Parse(Console.ReadLine());

        for (int i = 1; i <= n; i++)
        {
            Console.Write(a + " ");
            c = a + b;
            a = b;
            b = c;
        }
    }
}
